NEXT_PUBLIC_SITE_URL=https://vistaplay.shop

# TODO(client): confirm the WhatsApp Business number (international format, digits only, e.g. 34600000000)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Order form emails (Resend). Without these set, order submissions are
# logged to the server console instead of sent, in development only.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ORDER_NOTIFICATION_EMAIL=
# Reply-To on the customer confirmation email only. Sent without a
# Reply-To header if left empty.
RESEND_REPLY_TO=
