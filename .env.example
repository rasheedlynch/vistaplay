# Order emails (Resend). Orders are sent to ORDER_EMAIL, defined in lib/site.ts.
# Without these set, order submissions are logged to the server console
# instead of sent, in development only (in production the form shows an error).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Reply-To on the customer confirmation email only. Sent without a
# Reply-To header if left empty.
RESEND_REPLY_TO=
